# docker-compose.dev.yml 변수 오버라이드용 템플릿
# 사용법:
#   1. `.env` 파일로 복사: cp .env.example .env
#   2. 프로덕션 배포 시 실제 값으로 교체
#   3. `.env`는 `.gitignore`에 포함 (커밋 금지)
#
# Docker Secrets나 k8s Secret을 쓰는 경우 이 파일 대신 docs/deploy-secrets.md 참조.

# ── DB 크레덴셜 (compose가 timescaledb + backend + frontend에 일괄 주입) ──
DB_NAME=slm
DB_USER=slm_dev
# 프로덕션: openssl rand -base64 24 로 생성한 강한 값
DB_PASSWORD=slm_dev_1234

# ── NextAuth 시크릿 ──
# 프로덕션: openssl rand -base64 32 로 생성한 무작위 값
# 절대 기본값을 그대로 사용하지 말 것
NEXTAUTH_SECRET=change-me-in-production
NEXTAUTH_URL=https://localhost:3000

# ── API 엔드포인트 ──
NEXT_PUBLIC_API_URL=http://localhost:8000
INTERNAL_API_URL=http://backend:8000
NEXT_PUBLIC_DEMO_MODE=false

# ── DATABASE_URL (Next.js 쪽) ──
# 프로덕션: DB_PASSWORD 변수와 함께 교체
DATABASE_URL=postgresql://slm_dev:slm_dev_1234@timescaledb:5432/slm

# ── Ollama ──
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:26b

# 외부망 통화 TURN 옵션 (docs/realtime-comm-spec.md §5.5) — 기본 비활성
TURN_ENABLED=0
TURN_HOST=
TURN_SECRET=
TURN_EXTERNAL_IP=

# 환경 변수 파일 (시크릿 포함) — 절대 커밋 금지
.env
.env.*
!.env.example

# HTTPS 자기서명 인증서 (호스트별 SAN 다르므로 git 관리 X) — 재발급: certs/README.md
/certs/*.pem
/certs/*.exe

# 로그·임시
*.log
.DS_Store

# dev artifacts (스크린샷·로그·덤프) — 커밋 제외, 로컬 참고용
/screenshots/
/dev-logs/
/dev-data/

# 테스트·임시 산출물 (Playwright snapshot/console, 시각 검증 png) — 커밋 제외
/tmp/
/.playwright-mcp/
certs/.Caddyfile.generated
